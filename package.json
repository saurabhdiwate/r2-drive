    "dompurify": "^3.4.13",
    "lucide-react": "^1.29.0",
    "marked": "^18.0.9",
    "next": "14.2.5",
    "prismjs": "^1.30.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
