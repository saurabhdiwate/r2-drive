# ─── Authentication ───────────────────────────────────────────────────────────
# Single admin login. All values are server-side only.

# Login username.
APP_USERNAME=admin

# Bcrypt hash of the login password.
# Generate one with:  node scripts/hash-password.mjs -- "your-password"
#
# IMPORTANT: if you paste the hash into a `.env` / `.env.local` file that Next.js
# reads, every `$` MUST be escaped as `\$` (Next.js expands `$` sequences even
# inside quotes). Example:
#   APP_PASSWORD_HASH=\$2b\$12\$WgYi9.aT2MI.Ih6liRS3QeRvpnch8hnxJqyjkbLboCmi7vGRdv8b.
# When you set it as a real environment variable (Docker, EasyPanel, systemd),
# paste the hash without escaping: $2b$12$WgYi9...
APP_PASSWORD_HASH=

# Random secret used to sign session cookies.
# Generate one with:  node scripts/generate-secret.mjs
SESSION_SECRET=

# Optional. Set to "false" only if the app is served over plain HTTP (no TLS).
# In production the session cookie is marked Secure by default, which requires HTTPS.
# COOKIE_SECURE=false

# Optional. Session lifetime in hours (default: 168 = 7 days).
# SESSION_DURATION_HOURS=168

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Find these in the Cloudflare dashboard: R2 -> Manage R2 API Tokens, and your
# Account ID on the dashboard overview page. The app lists buckets at runtime,
# so no bucket name is required.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional. Overrides the default endpoint
# (https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com).
# R2_ENDPOINT=
